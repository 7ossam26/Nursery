# Dokploy environment for ONE nursery installation. Paste into the Compose service's Environment tab.
# Every value marked <required> is a real deployment input (OPERATIONS.md). Never commit a filled copy.

# Release identity (Dokploy build): the git short SHA or tag being deployed.
RELEASE_VERSION=<required: e.g. 3f2a9c1>
# NURSERY_IMAGE=registry.example/nursery-app:3f2a9c1   # only when the image is built elsewhere

# Installation identity — unique per nursery; changing it later breaks bootstrap markers and backup identity checks.
INSTALLATION_ID=<required: uuid v4, e.g. from `node -e "console.log(crypto.randomUUID())"`>
APP_ORIGIN=https://<required: nursery domain, exactly the origin Dokploy routes to service api>
SUPPORT_CONTACT=<required: support phone/contact text shown to staff>
BUSINESS_TIMEZONE=Africa/Cairo

# PostgreSQL (private service on the compose network; never published)
POSTGRES_DB=nursery
POSTGRES_USER=nursery
POSTGRES_PASSWORD=<required: 32+ URL-safe random characters, e.g. `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`>

# Sessions — 32+ random characters; rotating it signs every user out.
SESSION_SECRET=<required: e.g. `node -e "console.log(crypto.randomBytes(48).toString('base64url'))"`>

# Backups (D23): encrypted recovery sets in the private `backups` volume plus an off-host copy.
BACKUP_ENCRYPTION_KEY=<required: 64 hex characters, e.g. `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`; keep a copy OUTSIDE the server or the backups are unreadable>
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MANUAL=4
# Off-host destination: a directory mounted from remote storage (Hetzner Storage Box / rclone / NFS) into the
# worker and migrate services at /offsite (uncomment the OFFSITE_MOUNT lines in docker-compose.yml), or `none`
# when Dokploy's own Volume Backups ship the `backups` volume to S3 instead. `local-development-only` is refused.
BACKUP_TARGET=directory:/offsite
# OFFSITE_MOUNT=/mnt/nursery-offsite

# Proxy trust: Traefik reaches the container over the private Docker network only.
TRUST_PROXY=uniquelocal
