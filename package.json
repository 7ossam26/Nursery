{
  "name": "nursery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.1.0",
  "engines": { "node": "24.19.0", "npm": "11.1.0" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p infra/tsconfig.json",
    "test:unit": "vitest run --passWithNoTests --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:recovery": "vitest run --config vitest.recovery.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:release": "vitest run --config vitest.release.config.ts",
    "db:migrate": "npm run db:migrate -w @nursery/db",
    "db:seed:demo": "npm run db:seed:demo -w @nursery/db",
    "auth:bootstrap": "tsx apps/api/src/auth-command.ts bootstrap",
    "auth:recover-system": "tsx apps/api/src/auth-command.ts recover-system",
    "start": "node --import tsx apps/api/src/server.ts",
    "start:api": "node --import tsx apps/api/src/server.ts",
    "start:worker": "node --import tsx apps/worker/src/worker.ts",
    "env:check": "tsx infra/scripts/check-env.ts",
    "release:prepare": "tsx infra/scripts/release.ts",
    "backup:create": "tsx infra/scripts/backup.ts",
    "backup:restore": "tsx infra/scripts/restore.ts",
    "support:bundle": "tsx infra/scripts/support-bundle.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.50.0",
    "@typescript-eslint/parser": "8.50.0",
    "axe-core": "4.13.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
